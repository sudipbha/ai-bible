# INACTIVE TEMPLATE. GitHub runs nothing from this path.
# It becomes a workflow only if someone copies it to .github/workflows/ (see ci/README.md).
# Synthetic fixtures only: no signing, no secrets, no caches, no uploaded artifacts.
name: AIBible iOS unit tests

on:
  workflow_dispatch:
  pull_request:
    paths:
      - "apps/ai-bible-ios/**"

permissions:
  contents: read

concurrency:
  group: aibible-ios-${{ github.ref }}
  cancel-in-progress: true

jobs:
  unit-tests:
    runs-on: macos-26            # standard GitHub-hosted arm64 image (not -large / -xlarge)
    timeout-minutes: 30
    env:
      # Pinned from the runner-images inventory for macos-26 arm64 image 20260907.0351.1
      # (macOS 26.6.2): Xcode 26.6, build 17F113. The script fails if either differs.
      DEVELOPER_DIR: /Applications/Xcode_26.6.app/Contents/Developer
      AIBIBLE_EXPECT_XCODE_BUILD: 17F113
      # One ephemeral iPhone SE (3rd generation) on the installed iOS 26.5 runtime. The image lists
      # no pre-created SE; the script checks the runtime supports this device type and fails
      # without substituting another device or downloading a runtime.
      AIBIBLE_SIM_DEVICE_TYPE: com.apple.CoreSimulator.SimDeviceType.iPhone-SE-3rd-generation
      AIBIBLE_SIM_RUNTIME: com.apple.CoreSimulator.SimRuntime.iOS-26-5
    steps:
      - name: Check out (read-only token, not persisted)
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Generate project and run unit tests
        run: bash apps/ai-bible-ios/ci/run-tests.sh
